//スクロール量の調整(デフォルト150)

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整

&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/ {
    combos {
        compatible = "zmk,combos";

        //////左クリックのコンボ 19はJのキー 20はKのキーに相当します。
        ////combo_LCLK {
        ////    timeout-ms = <50>;
        ////    key-positions = <19 20>;
        ////    bindings = <&mkp LCLK>;
        ////};
        //////右クリックのコンボ 20 K 21 L
        ////combo_RCLK {
        ////    timeout-ms = <50>;
        ////    key-positions = <20 21>;
        ////    bindings = <&mkp RCLK>;
        ////};
        //////ホイールクリックのコンボ 19 J 21 L
        ////combo_MCLK {
        ////    timeout-ms = <90>;
        ////    key-positions = <19 21>;
        ////    bindings = <&mkp MCLK>;
        ////};
        //隼追加　ブートローダーのコンボ

        combo_BootLoader {
            timeout-ms = <50>;
            key-positions = <6 7 38 43>;
            bindings = <&bootloader>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0_Base {
            bindings = <
&kp TAB    &kp Q     &kp W          &kp E  &kp R      &kp T            &kp Y  &kp U     &kp I      &kp O    &kp P      &kp MINUS
&kp RET    &kp A     &kp S          &kp D  &kp F      &kp G            &kp H  &kp J     &kp K      &kp L    &kp AT     &mo 3
&kp LSHFT  &kp Z     &kp X          &kp C  &kp V      &kp B            &kp N  &kp M     &kp COMMA  &kp DOT  &kp SLASH  &kp UNDER
&kp LCTRL  &kp LALT  &kp BACKSPACE  &mo 1  &kp SPACE  &kp RIGHT_SHIFT  &mo 4  &kp LGUI
            >;

            //////&ec_ms_lとrは、上のビヘイビアで作ったもの。
            ////sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
            //隼追加　左手エンコーダでタブ／シフトタブ、右手エンコーダで音量の上下

            sensor-bindings = <&inc_dec_kp LS(TAB) TAB &inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer1_Cursors,Numbers {
            bindings = <
&trans  &none   &kp HOME  &kp UP    &kp END    &kp PG_UP      &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp MINUS   &trans
&trans  &none   &kp LEFT  &kp DOWN  &kp RIGHT  &kp PG_DN      &kp COMMA  &kp N4  &kp N5  &kp N6  &kp SLASH   &trans
&trans  &none   &none     &none     &none      &kp BACKSPACE  &kp N0     &kp N1  &kp N2  &kp N3  &kp PERIOD  &trans
&trans  &trans  &trans    &trans    &trans     &mo 2          &none      &trans
            >;
        };

        layer2_Symbols {
            bindings = <
&trans  &kp EXCL  &kp DOUBLE_QUOTES  &kp HASH  &kp DOLLAR  &kp PERCENT  &kp AMPS   &kp SINGLE_QUOTE  &kp LPAR          &kp RPAR           &kp TILDE  &kp BACKSLASH
&trans  &none     &none              &none     &none       &none        &none      &none             &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PLUS   &kp PIPE
&trans  &none     &none              &none     &none       &trans       &kp LT     &kp GT            &kp SEMI          &kp COLON          &kp ASTRK  &trans
&trans  &trans    &trans             &trans    &trans      &trans       &kp CARET  &trans
            >;

            //////レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。
            ////sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        layer3_Functions,MouseKeys {
            bindings = <
&kp ESC  &none   &kp F7     &kp F8            &kp F9          &kp F12    &kp LC(LA(F1))  &none      &mkp MCLK  &none  &none  &trans
&trans   &none   &kp F4     &kp F5            &kp F6          &kp F11    &mkp MB4        &mkp LCLK  &mkp RCLK  &none  &none  &trans
&trans   &none   &kp F1     &kp F2            &kp F3          &kp F10    &mkp MB5        &none      &none      &none  &none  &trans
&trans   &trans  &kp LANG2  &kp INT_MUHENKAN  &kp INT_HENKAN  &kp LANG1  &none           &trans
            >;
        };

        layer4_System {
            bindings = <
&none  &none       &none  &none  &none  &none  &bt BT_CLR  &none  &none  &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1
&none  &none       &none  &none  &none  &none  &none       &none  &none  &none         &bt BT_SEL 2  &bt BT_SEL 3
&none  &none       &none  &none  &none  &none  &none       &none  &none  &none         &bt BT_SEL 4  &bt BT_NXT
&none  &sys_reset  &none  &none  &none  &none  &none       &none
            >;
        };

        scroll { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
