//スクロール量の調整(デフォルト150)

#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ec_ms_l: ec_ms_h {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };

        ec_ms_r: ec_ms_v {
            compatible = "zmk,behavior-encoder-mouse-scroll";
            #sensor-binding-cells = <2>;
        };
    };
};

//スクロールの調整

&msc {
    time-to-max-speed-ms = <0>;   // 即座に最大速度（加速なし）
    acceleration-exponent = <0>;   // 加速なし
};

/ {
    combos {
        compatible = "zmk,combos";

        //左クリックのコンボ 19はJのキー 20はKのキーに相当します。

        combo_LCLK {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mkp LCLK>;
        };

        //右クリックのコンボ 20 K 21 L

        combo_RCLK {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&mkp RCLK>;
        };

        //ホイールクリックのコンボ 19 J 21 L

        combo_MCLK {
            timeout-ms = <90>;
            key-positions = <19 21>;
            bindings = <&mkp MCLK>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        layer0_Base {
            bindings = <
&kp TAB    &kp Q     &kp W          &kp E  &kp R      &kp T            &kp Y  &kp U     &kp I      &kp O    &kp P      &kp MINUS
&kp RET    &kp A     &kp S          &kp D  &kp F      &kp G            &kp H  &kp J     &kp K      &kp L    &kp AT     &mo 3
&kp LSHFT  &kp Z     &kp X          &kp C  &kp V      &kp B            &kp N  &kp M     &kp COMMA  &kp DOT  &kp SLASH  &mo 2
&kp LCTRL  &kp LALT  &kp BACKSPACE  &mo 1  &kp SPACE  &kp RIGHT_SHIFT  &none  &kp LGUI
            >;

            //&ec_ms_lとrは、上のビヘイビアで作ったもの。

            sensor-bindings = <&ec_ms_l SCRL_LEFT SCRL_RIGHT &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        layer1_Number,Cursor {
            bindings = <
&none   &kp EQUAL  &kp N7  &kp N8  &kp N9  &kp MINUS   &kp PG_UP  &kp HOME  &kp UP    &kp END    &trans  &trans
&trans  &kp COMMA  &kp N4  &kp N5  &kp N6  &kp SLASH   &kp PG_DN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &kp N0     &kp N1  &kp N2  &kp N3  &kp PERIOD  &trans     &trans    &trans    &trans     &trans  &trans
&trans  &trans     &trans  &trans  &trans  &trans      &trans     &trans
            >;
        };

        layer2_Symbols {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3   &kp F4   &kp F5   &trans  &trans    &kp MINUS  &kp EQUAL  &trans     &trans
&trans  &kp F6   &kp F7   &kp F8   &kp F9   &kp F10  &trans  &kp LBKT  &kp RBKT   &kp NUBS   &trans     &trans
&trans  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &trans  &kp SEMI  &kp SQT    &trans     &kp QMARK  &kp BSLH
&trans  &trans   &trans   &trans   &trans   &trans   &trans  &trans
            >;

            //レイヤー2のときだけ、左手のエンコーダを回すとボリュームの上下ができるようになっています。

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &ec_ms_r SCRL_DOWN SCRL_UP>;
        };

        layer3_Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans    &trans     &mkp MCLK  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB4  &mkp LCLK  &mkp RCLK  &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB5  &trans     &trans     &trans        &bt BT_CLR_ALL  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &out OUT_BLE  &trans    &trans
            >;
        };

        layer4_Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans        &trans    &trans     &mkp MCLK  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB4  &mkp LCLK  &mkp RCLK  &trans        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans        &mkp MB5  &trans     &trans     &trans        &bt BT_CLR_ALL  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &out OUT_BLE  &trans    &trans
            >;
        };

        scroll { status = "reserved"; };

        extra2 { status = "reserved"; };
    };
};
